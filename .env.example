# Modelo de configuração. Nunca coloque credenciais reais neste arquivo.
# Copie para .env (fora do Git) ou configure as variáveis no ambiente de hospedagem.
# Gere a chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Primeiro administrador: defina somente durante a instalação inicial.
# Use uma senha exclusiva com pelo menos 12 caracteres. Remova estas variáveis
# do ambiente de hospedagem depois de confirmar o primeiro acesso administrativo.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# PostgreSQL opcional: deixe vazio para usar SQLite local.
DATABASE_URL=

# Segredo persistente, aleatório e exclusivo da instalação (mínimo 32 caracteres em produção).
SECRET_KEY=

# Ative quando a aplicação estiver publicada atrás de HTTPS.
COOKIE_SECURE=1
ENVIRONMENT=production

# URL pública HTTPS usada nos links de primeiro acesso e recuperação.
APP_BASE_URL=https://seu-dominio.example

# SMTP — sem configuração válida, nenhum link de recuperação será enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_SECURITY=
