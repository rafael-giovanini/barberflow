# Copie para o ambiente de execução e preencha os valores reais fora do Git.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Ative apenas quando a aplicação estiver publicada atrás de HTTPS.
COOKIE_SECURE=1

# Recuperação de senha: obrigatoriamente URL pública HTTPS.
APP_BASE_URL=https://seu-dominio.example

# SMTP — sem configuração válida, nenhum link de recuperação será enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
